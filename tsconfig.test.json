{
  // The base config sets rootDir to ./src so the build emits a clean tree,
  // which also means tests/ and tools/ are invisible to `tsc --noEmit`.
  // This config typechecks them without touching the build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "allowJs": true,
    // Plain-JS tools opt in per file with `// @ts-check`; without this every
    // untyped local in them becomes an error and drowns out the real findings.
    "checkJs": false,
    "types": ["node"]
  },
  "include": ["src/**/*", "tests/**/*", "tools/**/*", "*.config.ts"]
}
